datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("ADMIN") // ADMIN, MANAGER, STAFF
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ServiceCategory {
  id           String    @id @default(uuid())
  name         String
  slug         String    @unique
  description  String?
  displayOrder Int       @default(0)
  services     Service[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Service {
  id              String          @id @default(uuid())
  name            String
  slug            String          @unique
  description     String
  price           Float
  durationMinutes Int
  image           String?
  isActive        Boolean         @default(true)
  isFeatured      Boolean         @default(false)
  categoryId      String
  category        ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  staffServices   StaffService[]
  appointments    Appointment[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Staff {
  id            String         @id @default(uuid())
  name          String
  role          String         // e.g., Senior Hair Stylist, Colorist, Esthetician
  bio           String?
  image         String?
  isAvailable   Boolean        @default(true)
  workDays      String         @default("1,2,3,4,5,6") // Comma-separated days of week (0=Sun, 1=Mon, ..., 6=Sat)
  startTime     String         @default("10:00")
  endTime       String         @default("20:00")
  staffServices StaffService[]
  appointments  Appointment[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model StaffService {
  id        String   @id @default(uuid())
  staffId   String
  serviceId String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([staffId, serviceId])
}

model Customer {
  id           String        @id @default(uuid())
  name         String
  phone        String        @unique
  email        String?
  notes        String?
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Appointment {
  id              String   @id @default(uuid())
  appointmentCode String   @unique // e.g. AUR-8921
  customerId      String
  serviceId       String
  staffId         String?  // null if "any available"
  date            String   // YYYY-MM-DD
  startTime       String   // HH:mm
  endTime         String   // HH:mm
  price           Float
  status          String   @default("CONFIRMED") // PENDING, CONFIRMED, COMPLETED, CANCELLED, NO_SHOW
  notes           String?
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service         Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff           Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Availability {
  id             String  @id @default(uuid())
  dayOfWeek      Int     @unique // 0=Sun, 1=Mon, ..., 6=Sat
  isOpen         Boolean @default(true)
  openTime       String  @default("10:00")
  closeTime      String  @default("20:00")
  breakStartTime String? @default("14:00")
  breakEndTime   String? @default("15:00")
}

model BlackoutDate {
  id        String   @id @default(uuid())
  date      String   @unique // YYYY-MM-DD
  reason    String?
  createdAt DateTime @default(now())
}

model Offer {
  id             String   @id @default(uuid())
  title          String
  description    String
  code           String?  @unique
  discountPercent Int?
  fixedDiscount  Float?
  validUntil     String   // YYYY-MM-DD
  isActive       Boolean  @default(true)
  image          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model GalleryImage {
  id           String   @id @default(uuid())
  title        String
  category     String   // Hair, Skin, Nails, Interior, Spa
  imageUrl     String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
}

model SalonSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String
}
